<?xml version="1.0" encoding="UTF-8"?>
<evaml
  name="teste"
  xsi:noNamespaceSchemaLocation="../robot_package/xml_schema/evaml_schema.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <settings>
    <voice type="en_US-bryce-medium" />
    <lightEffects mode="ON" />
    <audioEffects mode="ON" />
    <robotAffectiveProfile profile="OPTIMISTIC" />
  </settings>
  <script>
    <wait duration="1" />

    <mqtt pubTopic="expression">speech_on_2</mqtt>
    <talk>Oops</talk>
    <mqtt pubTopic="expression">speech_off_2</mqtt>
    <wait duration="1"/>
    <mqtt pubTopic="expression">speech_on_2</mqtt>
    <talk>Ok Marcélo! See you later</talk>
    <wait duration="5" />

    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />
    <mqtt pubTopic="expression">speech_on_2</mqtt>
    <talk>Hello Marcélo!</talk>
    <talk>How are you doing?</talk>
    <mqtt pubTopic="expression">speech_off_2</mqtt>
    <perception action="START" sources="TER, FER"/>
    <listen />
    <!-- hello fred I'm a bit tired because I worked so much -->
    <mqtt pubTopic="TER_TEXT">hello fred I'm a bit tired because I worked so much</mqtt>
    <perception action="END" />
    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />

    <switch var="aeb_affective_state">
      <case op="contain" value="sadness">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>There are days that are truly exhausting; you definitely need to rest.</talk>
        <mqtt pubTopic="expression">speech_off_1</mqtt>
      </case>
      <case op="contain" value="happiness">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Hey, come on! Don't be sad—let's move forward!</talk>
        <mqtt pubTopic="expression">speech_off_1</mqtt>
      </case>
    </switch>

    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />

    <mqtt pubTopic="expression">speech_on_2</mqtt>
    <talk>But tell me one thing: how are you feeling today?</talk>
    <mqtt pubTopic="expression">speech_off_2</mqtt>
    <perception action="START" sources="TER, FER"/>
    <listen />
    <!-- someone broke their promise today and I am more than upset -->
    <mqtt pubTopic="TER_TEXT">someone broke their promise today and I am more than upset</mqtt>
    <perception action="END" />

    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />
    
    <switch var="aeb_affective_state"> 
      <case op="contain" value="anger">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Wow, that's really bad! I hope you got your revenge.</talk> 
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
      <case op="contain" value="happiness">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Calm down man! Jesus teaches us to forgive our enemies!</talk> 
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
    </switch>

    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />

    <mqtt pubTopic="expression">speech_on_2</mqtt>
    <talk>Please, answer me one thing, using only your facial expression.</talk>
    <wait duration="1" />
    <talk>Did you enjoy interacting with me?</talk>
    <mqtt pubTopic="expression">speech_off_2</mqtt>
    <perception action="START" sources="FER"/>
    <wait duration="4" />
    <perception action="END" />
    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />
    <wait duration="1" />
    <switch var="aeb_affective_state"> 
      <case op="exact" value="happiness_l3">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Wow, it was great Marcélo.</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
        <wait duration="1"/>
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Bye bye!</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
      <case op="exact" value="happiness_l4">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Wow, it was great Marcélo.</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
        <wait duration="1"/>
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Bye bye!</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
      <case op="exact" value="happiness_l2">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Oops</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
        <wait duration="1"/>
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Sorry Marcélo. See you later</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
      <case op="exact" value="happiness_l1">
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Oops</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
        <wait duration="1"/>
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Sorry Marcélo. See you later</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </case>
      <default >
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Oops</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
        <wait duration="1"/>
        <mqtt pubTopic="expression">speech_on_2</mqtt>
        <talk>Sorry Marcélo. See you later</talk>
        <mqtt pubTopic="expression">speech_off_2</mqtt>
      </default>
    </switch>
    <wait duration="1" />
    <useMacro macro="AEB_EXECUTE" />



    
    <!-- <debug operation="SHOW_SYSTEM_VARS" /> -->
    <!-- <wait duration="1" />
    <debug operation="SHOW_SYSTEM_VARS" />
    <useMacro macro="AEB_EXECUTE" /> -->
    <!-- <wait duration="3" />
    <debug operation="SHOW_SYSTEM_VARS" />
    <switch var="aeb_affective_state">
      <case op="exact" value="happiness_l1">
        <led animation="GREEN" />
      </case>
      <default>
        <led animation="RED" />
      </default>
    </switch> -->
    <!-- <wait duration="2" />
    <perception action="START" sources="TER"/>
    <mqtt pubTopic="TER_TEXT">I am so angry today!</mqtt>
    <wait duration="2" />
    <perception action="END" />
    <wait duration="5" />
    <perception action="START" sources="TER"/>
    <mqtt pubTopic="TER_TEXT">I am so sad today!</mqtt>
    <wait duration="2" />
    <perception action="END" />
    <wait duration="5" />
    <perception action="START" sources="TER"/>
    <mqtt pubTopic="TER_TEXT">Hello, how are you?</mqtt>
    <wait duration="2" />
    <perception action="END" />
    <wait duration="5" />
    <perception action="START" sources="TER"/>
    <mqtt pubTopic="TER_TEXT">I am so happy!</mqtt>
    <wait duration="2" />
    <perception action="END" /> -->
  </script>
  <macros>
    <macro id="AEB_EXECUTE">
      <switch var="aeb_affective_state">
        <!-- ############################## -->
        <!-- Neutral affective state ###### -->
        <!-- ############################## -->
        <case op="exact" value="neutral">
          <light state="ON" color="WHITE"/>
          <evaEmotion emotion="NEUTRAL" />
          <led animation="STOP" />
          <pose type="NEUTRAL" />
        </case>

        <!-- ############################## -->
        <!-- Happiness affective state #### -->
        <!-- ############################## -->
        <case op="exact" value="happiness_l1">
          <light state="ON" color="GREEN"/>
          <evaEmotion emotion="PLEASED" />
          <led animation="HAPPY0" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="happiness_l2">
          <light state="ON" color="GREEN"/>
          <evaEmotion emotion="PLEASED" />
          <led animation="HAPPY1" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="happiness_l3">
          <light state="ON" color="GREEN"/>
          <evaEmotion emotion="HAPPY" />
          <led animation="HAPPY2" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="happiness_l4">
          <light state="ON" color="GREEN"/>
          <evaEmotion emotion="HAPPY" />
          <led animation="HAPPY2" />
          <pose type="LEFT_FOOT1" />
        </case>
        
        <!-- ################################################################################################## -->
        <!-- Anger affective state ######################################################################## -->
        <!-- ################################################################################################## -->
        <case op="exact" value="anger_l1">
          <light state="ON" color="RED"/>
          <evaEmotion emotion="NEUTRAL" />
          <led animation="ANGRY0" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="anger_l2">
          <light state="ON" color="RED"/>
          <evaEmotion emotion="NEUTRAL" />
          <led animation="ANGRY1" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="anger_l3">
          <light state="ON" color="RED"/>
          <evaEmotion emotion="ANGRY" />
          <led animation="ANGRY2" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="anger_l4">
          <light state="ON" color="RED"/>
          <evaEmotion emotion="ANGRY2" />
          <led animation="ANGRY2" />
          <pose type="NEUTRAL" />
        </case>

        <!-- ################################################################################################## -->
        <!-- Sadness affective state ######################################################################## -->
        <!-- ################################################################################################## -->
        <case op="exact" value="sadness_l1">
          <light state="ON" color="BLUE"/>
          <evaEmotion emotion="SAD" />
          <led animation="SAD0" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="sadness_l2">
          <light state="ON" color="BLUE"/>
          <evaEmotion emotion="SAD" />
          <led animation="SAD1" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="sadness_l3">
          <light state="ON" color="BLUE"/>
          <evaEmotion emotion="SAD" />
          <led animation="SAD2" />
          <pose type="NEUTRAL" />
        </case>
        <case op="exact" value="sadness_l4">
          <light state="ON" color="BLUE"/>
          <evaEmotion emotion="SAD" />
          <led animation="SAD2" />
          <pose type="SAD_FOOT_SLOW" />
        </case>

      </switch>
    </macro>
  </macros>
</evaml>